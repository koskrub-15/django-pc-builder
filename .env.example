# Never ship True. With DEBUG=False the settings switch on HSTS, secure
# cookies, and the HTTPS redirect, so serve over TLS when you turn it off.
DJANGO__DEBUG=True

# Generate your own before running anything you care about:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO__SECRET_KEY="replace-me-with-a-generated-secret-key"

DJANGO__ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to send authenticated POSTs (scheme required).
DJANGO__CSRF_TRUSTED_ORIGINS=http://localhost:8080

POSTGRES_HOST=localhost
POSTGRES_PORT=55432

POSTGRES_USER="django_user"
POSTGRES_PASSWORD="your-password"
POSTGRES_DB="django_db"

REDIS_HOST=localhost
REDIS_PORT=6380

# Optional. Shown on the About page; leave blank and those sections are hidden.
SITE__OWNER_NAME=
SITE__OWNER_ROLE=
SITE__OWNER_BIO=
SITE__OWNER_GITHUB=
SITE__OWNER_TELEGRAM=
SITE__OWNER_LINKEDIN=
SITE__OWNER_EMAIL=

# Contact-form messages are delivered to EMAIL_HOST_USER.
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_HOST_USER="your-email"
EMAIL_HOST_PASSWORD="your-email-password"
EMAIL_USE_TLS=True
